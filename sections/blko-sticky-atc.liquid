<i hidden data-blko-block="sticky-atc"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign blko_show = true
  if product and section.settings.only_collection != blank
    assign blko_show = false
    for blko_c in product.collections
      if blko_c.id == section.settings.only_collection.id
        assign blko_show = true
        break
      endif
    endfor
  endif
  if product and blko_show and section.settings.only_tag != blank
    assign blko_tag = section.settings.only_tag | strip | downcase
    assign blko_show = false
    for blko_t in product.tags
      assign blko_tt = blko_t | downcase
      if blko_tt == blko_tag
        assign blko_show = true
        break
      endif
    endfor
  endif
-%}
{%- if blko_show -%}
{%- assign v0 = product.selected_or_first_available_variant -%}
<div class="blko-sa{% unless section.settings.show_on_mobile %} blko-sa-nm{% endunless %}" id="blko-sa-{{ section.id }}" hidden>
<style>
#blko-sa-{{ section.id }}{position:fixed;left:0;right:0;bottom:0;z-index:50;background:#fff;border-top:1px solid rgba(0,0,0,.12);box-shadow:0 -4px 16px rgba(0,0,0,.08);font:inherit;--c:{{ section.settings.color }};transform:translateY(110%);transition:transform .25s}
#blko-sa-{{ section.id }}.on{transform:none}
#blko-sa-{{ section.id }} .w{max-width:1200px;margin-inline:auto;padding:10px 16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
#blko-sa-{{ section.id }} img{width:48px;height:48px;object-fit:cover;border-radius:12px;border:1px solid rgba(0,0,0,.12)}
#blko-sa-{{ section.id }} .t{flex:1 1 120px;min-width:0}
#blko-sa-{{ section.id }} .n{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#blko-sa-{{ section.id }} .p{font-size:14px;opacity:.8}
#blko-sa-{{ section.id }} select,#blko-sa-{{ section.id }} input{padding:9px 10px;border:1px solid rgba(0,0,0,.12);border-radius:12px;font:inherit;background:#fff;max-width:160px}
#blko-sa-{{ section.id }} input{width:64px}
#blko-sa-{{ section.id }} button{padding:11px 20px;border:0;border-radius:12px;background:var(--c);color:#fff;font:inherit;font-weight:600;cursor:pointer}
#blko-sa-{{ section.id }} button:disabled{opacity:.5;cursor:not-allowed}
@media(max-width:600px){#blko-sa-{{ section.id }}.blko-sa-nm{display:none}#blko-sa-{{ section.id }} img{display:none}#blko-sa-{{ section.id }} button{flex:1}}
</style>
<div class="w">
{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">{%- endif -%}
<div class="t"><div class="n">{{ product.title }}</div><div class="p">{{ v0.price | money }}</div></div>
{%- if product.variants.size > 1 -%}
<select aria-label="Variant">{%- for v in product.variants -%}<option value="{{ v.id }}"{% if v.id == v0.id %} selected{% endif %}>{{ v.title }}</option>{%- endfor -%}</select>
{%- endif -%}
<input type="number" min="1" value="1" aria-label="Quantity">
<button type="button">{{ section.settings.button }}</button>
</div>
</div>
<script>
(function(){
var r=document.getElementById('blko-sa-{{ section.id }}'),V={{ product.variants | json }},
MF={{ shop.money_format | json }},SO={{ section.settings.soldout | json }},BT={{ section.settings.button | json }},
R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',
s=r.querySelector('select'),q=r.querySelector('input'),b=r.querySelector('button'),
p=r.querySelector('.p'),im=r.querySelector('img'),cur=V.filter(function(v){return v.id==={{ v0.id }}})[0]||V[0];
r.hidden=false;
if(window.matchMedia('(max-width:600px)').matches&&r.classList.contains('blko-sa-nm'))r.hidden=true;
function money(c){return MF.replace(/\{\{\s*\w+\s*\}\}/,(c/100).toFixed(2))}
function show(v){cur=v;p.textContent=money(v.price);b.disabled=!v.available;b.textContent=v.available?BT:SO;
if(s)s.value=v.id;if(im&&v.featured_image&&v.featured_image.src)im.src=v.featured_image.src}
function byId(id){return V.filter(function(v){return String(v.id)===String(id)})[0]}
show(cur);
if(s)s.addEventListener('change',function(){var v=byId(s.value);if(!v)return;show(v);
var e=document.querySelector('form[action*="/cart/add"] [name="id"]');if(e){e.value=v.id;e.dispatchEvent(new Event('change',{bubbles:true}))}});
function ext(){var e=document.querySelector('form[action*="/cart/add"] [name="id"]'),
id=(e&&e.value)||new URLSearchParams(location.search).get('variant'),v=id&&byId(id);if(v&&v.id!==cur.id)show(v)}
setInterval(ext,500);document.addEventListener('change',ext);
var tg=document.querySelector('form[action*="/cart/add"] [type="submit"],form[action*="/cart/add"] button[name="add"]');
function vis(on){r.classList.toggle('on',on)}
if(tg&&window.IntersectionObserver){new IntersectionObserver(function(e){var x=e[0];vis(!x.isIntersecting&&x.boundingClientRect.top<0)}).observe(tg)}
else{var sc=function(){vis(window.scrollY>600)};window.addEventListener('scroll',sc,{passive:true});sc()}
b.addEventListener('click',function(){if(!cur.available)return;b.disabled=true;
fetch(R+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:cur.id,quantity:Math.max(1,parseInt(q.value,10)||1)}]})})
.then(function(x){if(!x.ok)throw 0;return x.json()})
.then(function(){var d=document.querySelector('cart-drawer,cart-notification,#CartDrawer,[id*="cart-drawer"]'),
t=document.querySelector('a[href$="/cart"][aria-haspopup],#cart-icon-bubble,[data-cart-toggle],.js-drawer-open-cart,[data-drawer-open="cart"]');
document.dispatchEvent(new CustomEvent('cart:refresh'));
if(t&&d){t.click()}else if(d&&d.open){d.open()}else{location.href=R+'cart'}})
.catch(function(){b.textContent='!'})
.then(function(){setTimeout(function(){show(cur)},800)})});
})();
</script>
{%- endif -%}
{% schema %}
{"name":"Blocko Sticky ATC","settings":[{"type":"checkbox","id":"show_on_mobile","label":"Show on mobile","default":true},{"type":"text","id":"button","label":"Button text","default":"Add to cart"},{"type":"text","id":"soldout","label":"Sold out text","default":"Sold out"},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},{"type":"header","content":"Show on"},{"type":"collection","id":"only_collection","label":"Only products in this collection","info":"Leave both empty to show on every product."},{"type":"text","id":"only_tag","label":"Only products with this tag"}],"presets":[{"name":"Blocko Sticky ATC"}],"enabled_on":{"templates":["product"]}}
{% endschema %}
