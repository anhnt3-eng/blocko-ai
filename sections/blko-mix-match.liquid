<i hidden data-blko-block="mix-match"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign blko_show = true
  if product and section.settings.only_collection != blank
    assign blko_show = false
    for blko_c in product.collections
      if blko_c.id == section.settings.only_collection.id
        assign blko_show = true
        break
      endif
    endfor
  endif
  if product and blko_show and section.settings.only_tag != blank
    assign blko_tag = section.settings.only_tag | strip | downcase
    assign blko_show = false
    for blko_t in product.tags
      assign blko_tt = blko_t | downcase
      if blko_tt == blko_tag
        assign blko_show = true
        break
      endif
    endfor
  endif
-%}
{%- if blko_show -%}
{% assign st=section.settings %}{% assign fx=st.price|times:100|round|money %}{% assign hl=st.headline|replace:'{n}',st.size|replace:'{price}',fx %}
{%- capture gj -%}[{% assign sp='' %}{% for p in st.collection.products limit:8 %}{% if p.available %}{{ sp }}{"id":{{ p.first_available_variant.id }},"p":{{ p.first_available_variant.price }},"q":1,"t":{{ p.title|json }},"i":{{ p.featured_image|image_url:width:96|json }}}{% assign sp=',' %}{% endif %}{% endfor %}]{%- endcapture -%}
<style>
.blko-mm{max-width:1200px;margin-inline:auto;padding:40px 16px;
>*{max-width:520px}
.gr{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}
h3{grid-column:1/-1;margin:8px 0 0;font-size:1em}
.t{display:flex;align-items:center;gap:8px;min-width:0;padding:8px;background:#fff;color:#17151d;border:1px solid rgba(0,0,0,.12);border-radius:12px;font:inherit;cursor:pointer}
.on{border-color:var(--c)}
& img{width:48px;height:48px;flex:none;border-radius:8px;object-fit:cover}
& span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.a{width:100%;padding:12px;border:0;border-radius:99px;background:#17151d;color:#fff;font:inherit;cursor:pointer;&:disabled{opacity:.5}}}
</style>
<div class="blko-mm" id="blko-mm-{{ section.id }}" style="--c:{{ st.color }}" hidden>
<h2>{{ st.heading }}</h2><strong>{{ hl }}</strong><br><small>{{ st.sub }}</small>
<div class="gr"></div>
<button type="button" class="a"></button>
</div>
<script>(async()=>{var s=document.getElementById('blko-mm-{{ section.id }}'),b=s.querySelector('.a'),H=s.querySelector('strong'),gr=s.querySelector('.gr'),r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',J={'Content-Type':'application/json'},Z={{ st.size }},P={{ st.price|times:100|round }},
G=[{n:'',max:Z,l:{{ gj }}}],o,
m=c=>{{ shop.money_format|json }}.replace(/\{\{\s*\w+\s*\}\}/,(c/100).toFixed(2)),
e=(g,x,p)=>{var n=document.createElement(g);n.textContent=x||'';p.appendChild(n);return n};
if({{ st.use_aov|json }})try{var a={{ shop.metafields.avada_bundle.mixMatchOffers.value|json }};if(!a||a.error)a={{ shop.metafields.avada_bundle.mixMatchOffers|json }};
if(typeof a==='string')a=JSON.parse(a);a=(Array.isArray(a)?a:a&&a.id?[a]:Object.values(a||{})).map(x=>x&&x.setting||x);
o=a.find(x=>x&&x.status==='active'&&x.mixMatchProductHandle==={{ product.handle|json }});
if(o){var A=await Promise.all((o.bundleOptions||[]).map(async g=>{var l=[];for(var p of g.products||[]){try{var j=await(await fetch(r+'products/'+p.handle+'.js')).json(),v=j.variants.find(v=>v.available);if(v)l.push({id:v.id,p:v.price,q:p.quantity||1,t:j.title,i:j.featured_image&&j.featured_image+(j.featured_image.indexOf('?')<0?'?':'&')+'width=96'})}catch(x){}}return{n:g.optionName,max:1,l}}));
if(A.length&&A.every(g=>g.l.length)){G=A;s.querySelector('h2').textContent=o.offerTitle||'';s.querySelector('small').textContent=''}else o=0}}catch(x){o=0}
var K=G.map(g=>o?[g.l[0]]:[]),
u=()=>{var S=K.flat(),n=S.length,t=S.reduce((a,c)=>a+c.p*c.q,0),f=t,d=0,ok=G.every((g,i)=>K[i].length>=g.max);
if(o){d=Math.min(t,o.discountType==='percentage'?t*o.discountValue/100:o.discountValue*100);f=t-d;H.textContent='Total now '+m(f)+', you save '+m(d)}else if(ok)f=P;
G.forEach((g,i)=>g.l.forEach(c=>c.x.classList.toggle('on',K[i].includes(c))));
b.disabled=!ok;b.textContent=(ok?{{ st.add|json }}:{{ st.pick|json }}.replace('{n}',Z-n)).replace('{price}',m(f))};
G.forEach((g,gi)=>{if(o)e('h3',g.n,gr);g.l.forEach(c=>{var x=c.x=e('button',0,gr),k=K[gi],i;x.type='button';x.className='t';
if(c.i){i=e('img',0,x);i.src=c.i;i.alt='';i.width=i.height=96}e('span',c.t,x);
x.onclick=()=>{i=k.indexOf(c);if(i>-1){if(g.max>1)k.splice(i,1)}else if(k.length<g.max)k.push(c);else if(g.max<2)k[0]=c;u()}})});
u();s.hidden=false;
b.onclick=async()=>{b.disabled=true;try{var z=Array.from({length:3},()=>String.fromCharCode(65+Math.random()*26|0)).join(''),
items=G.flatMap((g,i)=>K[i].map(c=>o?{id:c.id,quantity:c.q,properties:{_aov_offerId:o.id,_aov_offerType:'mix-match-bundle',_aov_bundleGroup:o.id+'|'+z+'|'+i}}:{id:c.id,quantity:1})),
a=await fetch(r+'cart/add.js',{method:'POST',headers:J,body:JSON.stringify({items})});if(!a.ok)throw await a.json();
if(o&&o.code){var c=(await(await fetch(r+'cart.js')).json()).discount_codes.map(d=>d.code);if(!c.includes(o.code))c.push(o.code);
await fetch(r+'cart/update.js',{method:'POST',headers:J,body:JSON.stringify({discount:c.join(',')})})}
location.href=r+'cart'}catch(x){u();b.textContent=x.description||b.textContent}}})();</script>
{%- endif -%}
{% schema %}
{"name":"Blocko Mix & Match","enabled_on":{"templates":["product"]},"presets":[{"name":"Blocko Mix & Match"}],"settings":[{"type":"text","id":"heading","label":"Heading","default":"Mix and match"},{"type":"text","id":"sub","label":"Subtitle","default":"Mix any items you like"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"size","label":"Items per box","min":2,"max":6,"default":3},{"type":"number","id":"price","label":"Bundle price","default":40},{"type":"text","id":"headline","label":"Headline ({n}, {price})","default":"Any {n} for {price}"},{"type":"text","id":"pick","label":"Button before full ({price} = picked)","default":"Pick {n} more · {price}"},{"type":"text","id":"add","label":"Button when full","default":"Add box · {price}"},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},{"type":"checkbox","id":"use_aov","label":"Use the AOV.ai offer when there is one","default":true},{"type":"paragraph","content":"Two modes. Default: pick items from the collection for the bundle price above (display only: create a matching Shopify automatic discount so checkout charges it). With AOV.ai Bundle: on the product page of an active AOV.ai Mix & match offer, this block shows that offer's options and discount, adds the bundle with its code, and ignores the collection and price. Turn off AOV.ai's own widget to avoid a duplicate."},{"type":"header","content":"Show on"},{"type":"collection","id":"only_collection","label":"Only products in this collection","info":"Leave both empty to show on every product."},{"type":"text","id":"only_tag","label":"Only products with this tag"}]}
{% endschema %}
