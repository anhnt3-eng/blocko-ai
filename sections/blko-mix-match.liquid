<i hidden data-blko-block="mix-match"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{% assign st=section.settings %}{% assign fx=st.price|times:100|round|money %}{% assign hl=st.headline|replace:'{n}',st.size|replace:'{price}',fx %}
<style>
.blko-mm{max-width:1200px;margin-inline:auto;padding:40px 16px;
>*{max-width:520px}
.gr{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}
.t{display:flex;align-items:center;gap:8px;min-width:0;padding:8px;background:#fff;color:#17151d;border:1px solid rgba(0,0,0,.12);border-radius:12px;font:inherit;cursor:pointer}
.on{border-color:var(--c)}
& img{width:48px;height:48px;flex:none;border-radius:8px;object-fit:cover}
& span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.a{width:100%;padding:12px;border:0;border-radius:99px;background:#17151d;color:#fff;font:inherit;cursor:pointer;&:disabled{opacity:.5}}}
</style>
<div class="blko-mm" id="blko-mm-{{ section.id }}" style="--c:{{ st.color }}">
<h2>{{ st.heading }}</h2><strong>{{ hl }}</strong><br><small>{{ st.sub }}</small>
<div class="gr">{% for p in st.collection.products limit:8 %}{% if p.available %}<button type="button" class="t" data-id="{{ p.first_available_variant.id }}" data-p="{{ p.first_available_variant.price }}"><img width="96" height="96" src="{{ p.featured_image|image_url:width:96 }}" alt=""><span>{{ p.title|escape }}</span></button>{% endif %}{% endfor %}</div>
<button type="button" class="a"></button>
</div>
<script>(()=>{var s=document.getElementById('blko-mm-{{ section.id }}'),b=s.querySelector('.a'),r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',N={{ st.size }},P={{ st.price|times:100|round }},k=[],
m=c=>{{ shop.money_format|json }}.replace(/\{\{\s*\w+\s*\}\}/,(c/100).toFixed(2)),
u=()=>{var n=k.length;b.disabled=n<N;
b.textContent=(n<N?{{ st.pick|json }}.replace('{n}',N-n):{{ st.add|json }}).replace('{price}',m(n<N?k.reduce((a,x)=>a+ +x.dataset.p,0):P))};
s.querySelectorAll('.t').forEach(x=>x.onclick=()=>{var i=k.indexOf(x);if(i>-1)k.splice(i,1);else if(k.length<N)k.push(x);x.classList.toggle('on',k.includes(x));u()});u();
b.onclick=()=>{b.disabled=true;
fetch(r+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:k.map(x=>({id:+x.dataset.id,quantity:1}))})}).then(x=>x.json().then(j=>{if(!x.ok)throw j;location.href=r+'cart'})).catch(e=>{b.disabled=false;b.textContent=e.description})}})();</script>
{% schema %}
{"name":"Blocko Mix & Match","enabled_on":{"templates":["product"]},"presets":[{"name":"Blocko Mix & Match"}],
"settings":[
{"type":"text","id":"heading","label":"Heading","default":"Mix and match"},
{"type":"text","id":"sub","label":"Subtitle","default":"Mix any items you like"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"range","id":"size","label":"Items per box","min":2,"max":6,"default":3},
{"type":"number","id":"price","label":"Bundle price","default":40},
{"type":"text","id":"headline","label":"Headline ({n}, {price})","default":"Any {n} for {price}"},
{"type":"text","id":"pick","label":"Button before full ({price} = picked)","default":"Pick {n} more · {price}"},
{"type":"text","id":"add","label":"Button when full","default":"Add box · {price}"},
{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},
{"type":"paragraph","content":"The bundle price is display only. Create a matching Shopify automatic discount so checkout charges it."}]}
{% endschema %}
