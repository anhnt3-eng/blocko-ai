<i hidden data-blko-block="age-verification"></i>
<script src="{{ shop.secure_url }}/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign s = section.settings
  assign age = s.age | default: 18
  assign msg = s.text | replace: '[age]', age
  assign show = true
  if s.only_product and template.name != 'product'
    assign show = false
  endif
-%}
{%- if show -%}
<style>
#blko-av-{{ section.id }}{display:none;position:fixed;inset:0;z-index:2147483600;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.85);font:inherit}
#blko-av-{{ section.id }}.is-open{display:flex}
#blko-av-{{ section.id }} .blko-av-box{box-sizing:border-box;width:100%;max-width:440px;background:#fff;color:#1a1a1a;border-radius:12px;padding:32px 24px;text-align:center;border:1px solid rgba(0,0,0,.12)}
#blko-av-{{ section.id }} h2{margin:0 0 8px;font:inherit;font-size:24px;font-weight:700}
#blko-av-{{ section.id }} p{margin:0 0 20px}
#blko-av-{{ section.id }} .blko-av-row{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
#blko-av-{{ section.id }} button{font:inherit;font-weight:600;cursor:pointer;min-width:110px;padding:11px 20px;border-radius:12px;border:1px solid var(--blko-accent);background:#fff;color:var(--blko-accent)}
#blko-av-{{ section.id }} button.p{background:var(--blko-accent);color:#fff}
</style>
<div class="blko-av" id="blko-av-{{ section.id }}" style="--blko-accent:{{ s.color }}">
  <div class="blko-av-box" role="dialog" aria-modal="true" aria-labelledby="blko-av-h-{{ section.id }}" tabindex="-1">
    <h2 id="blko-av-h-{{ section.id }}">{{ s.heading | escape }}</h2>
    <p data-msg>{{ msg | escape }}</p>
    <div class="blko-av-row" data-btns>
      <button type="button" class="p" data-yes>{{ s.yes | escape }}</button>
      <button type="button" data-no>{{ s.no | escape }}</button>
    </div>
  </div>
</div>
<script>
(function(){
var root=document.getElementById('blko-av-{{ section.id }}');if(!root)return;
var KEY='blko-age-ok';
var days={{ s.days | default: 30 | json }},sorry={{ s.sorry | json }},redir={{ s.redirect | json }};
var box=root.querySelector('.blko-av-box'),prev=null,editor=!!window.Shopify&&Shopify.designMode;
function ok(){try{var t=parseInt(localStorage.getItem(KEY),10);return t&&Date.now()-t<days*864e5}catch(e){return false}}
function lock(){document.documentElement.style.overflow='hidden'}
function unlock(){document.documentElement.style.overflow=''}
function close(){root.classList.remove('is-open');unlock();document.removeEventListener('keydown',trap,true);if(prev&&prev.focus)prev.focus()}
function trap(e){
  if(e.key!=='Tab')return;
  var f=box.querySelectorAll('button');if(!f.length)return;
  var a=f[0],z=f[f.length-1];
  if(!box.contains(document.activeElement)){e.preventDefault();a.focus()}
  else if(e.shiftKey&&document.activeElement===a){e.preventDefault();z.focus()}
  else if(!e.shiftKey&&document.activeElement===z){e.preventDefault();a.focus()}
}
root.querySelector('[data-yes]').addEventListener('click',function(){
  try{localStorage.setItem(KEY,String(Date.now()))}catch(e){}
  close();
});
root.querySelector('[data-no]').addEventListener('click',function(){
  box.querySelector('h2').textContent=sorry;
  box.querySelector('[data-msg]').textContent='';
  box.querySelector('[data-btns]').textContent='';
  if(redir)window.location.href=redir;
});
if(editor||!ok()){
  prev=document.activeElement;
  root.classList.add('is-open');lock();
  document.addEventListener('keydown',trap,true);
  box.focus();
}
})();
</script>
{%- endif -%}
{% schema %}
{"name":"Blocko Age verification","enabled_on":{"groups":["footer"]},"presets":[{"name":"Blocko Age verification"}],"settings":[
{"type":"text","id":"heading","label":"Heading","default":"Age verification"},
{"type":"number","id":"age","label":"Minimum age","default":18},
{"type":"text","id":"text","label":"Text ([age] = minimum age)","default":"You must be [age] or older to enter."},
{"type":"text","id":"yes","label":"Yes button","default":"Yes"},
{"type":"text","id":"no","label":"No button","default":"No"},
{"type":"text","id":"sorry","label":"Sorry message","default":"Sorry, you cannot enter this site."},
{"type":"url","id":"redirect","label":"Redirect URL when No","info":"Optional. Empty = stay on the Sorry message."},
{"type":"number","id":"days","label":"Remember for (days)","default":30},
{"type":"checkbox","id":"only_product","label":"Only on product pages","default":false},
{"type":"color","id":"color","label":"Accent color","default":"#6538bd"}
]}
{% endschema %}
