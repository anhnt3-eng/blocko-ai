<i hidden data-blko-block="drawer-shipping"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{%- assign s = section.settings -%}
<div data-blko-drawer id="blko-ds-{{ section.id }}" style="--blko-accent:{{ s.color }}">
<script type="application/json" data-blko-cfg>
{"moneyFormat":{{ shop.money_format | json }},"title":{{ s.title | json }},"empty":{{ s.empty | json }},"checkout":{{ s.co | json }},"viewCart":{{ s.vc | json }},"ship":{"at":{{ s.thr | times: 100 }},"msg":{{ s.msg | json }},"done":{{ s.done | json }} } }
</script>
</div>
<script src="/apps/blocko/drawer.js" defer></script>
{% schema %}
{"name":"Blocko Drawer Shipping","enabled_on":{"groups":["header"]},"presets":[{"name":"Blocko Drawer Shipping"}],"settings":[{"type":"text","id":"title","label":"Title","default":"Your cart"},{"type":"text","id":"empty","label":"Empty text","default":"Your cart is empty"},{"type":"text","id":"co","label":"Checkout button","default":"Checkout"},{"type":"text","id":"vc","label":"Cart link","default":"View cart"},{"type":"number","id":"thr","label":"Free shipping at","default":75},{"type":"text","id":"msg","label":"Progress text","default":"Spend {amount} more for free shipping"},{"type":"text","id":"done","label":"Reached text","default":"You got free shipping"},{"type":"paragraph","content":"Blocko only shows progress. Create a free shipping rate in Shopify (Settings, Shipping) with the same minimum order price."},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"}]}
{% endschema %}
