<i hidden data-blko-block="cart-drawer"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{%- assign s = section.settings -%}
<div data-blko-drawer id="blko-cd-{{ section.id }}" style="--blko-accent:{{ s.color }}">
<script type="application/json" data-blko-cfg>
{"moneyFormat":{{ shop.money_format | json }},"title":{{ s.title | json }},"empty":{{ s.empty | json }},"checkout":{{ s.co | json }},"viewCart":{{ s.vc | json }}{%- if s.gb and s.gift -%},"gift":{"at":{{ s.thr | times: 100 }},"variant":{{ s.gift.selected_or_first_available_variant.id }},"title":{{ s.gift.title | json }},"msg":{{ s.msg | json }},"done":{{ s.unl | json }} }{%- endif -%}{%- if s.up -%},"upsell":{"source":"shopify","title":{{ s.uh | json }},"add":{{ s.add | json }},"limit":3 }{%- endif -%} }
</script>
</div>
<script src="/apps/blocko/drawer.js" defer></script>
{% schema %}
{"name":"Blocko Cart Drawer","enabled_on":{"groups":["header"]},"presets":[{"name":"Blocko Cart Drawer"}],"settings":[{"type":"text","id":"title","label":"Title","default":"Your cart"},{"type":"text","id":"empty","label":"Empty text","default":"Your cart is empty"},{"type":"text","id":"co","label":"Checkout button","default":"Checkout"},{"type":"text","id":"vc","label":"Cart link","default":"View cart"},{"type":"checkbox","id":"gb","label":"Gift bar"},{"type":"number","id":"thr","label":"Min spend","default":50},{"type":"product","id":"gift","label":"Gift"},{"type":"text","id":"msg","label":"Progress","default":"Spend {amount} more for a free {gift}"},{"type":"text","id":"unl","label":"Unlocked","default":"You unlocked a free {gift}"},{"type":"paragraph","content":"Blocko only shows gift progress. Create an automatic Shopify discount (100% off the gift) so checkout matches."},{"type":"checkbox","id":"up","label":"Upsell","default":true},{"type":"text","id":"uh","label":"Upsell title","default":"Pairs well with"},{"type":"text","id":"add","label":"Add button","default":"Add"},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"}]}
{% endschema %}
