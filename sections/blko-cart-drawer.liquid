<i hidden data-blko-block="cart-drawer"></i>
<script src="{{ shop.secure_url }}/apps/blocko/beacon.js" defer></script>
{%- assign s = section.settings -%}
<div data-blko-drawer id="blko-cd-{{ section.id }}" style="--blko-accent:{{ s.color }};--blko-br:{{ s.br }}px{% if s.ink != blank %};--blko-ink:{{ s.ink }}{% endif %}{% if s.bg != blank %};--blko-bg:{{ s.bg }}{% endif %}{% if s.panel != blank %};--blko-panel:{{ s.panel }};--blko-ta:center{% endif %}{% if s.btn != blank %};--blko-btn:{{ s.btn }}{% endif %}{% if s.btc != blank %};--blko-btc:{{ s.btc }}{% endif %}{% if s.fl %};--blko-gap:8px;--blko-fr:16px{% endif %}">
<script type="application/json" data-blko-cfg>
{"moneyFormat":{{ shop.money_format | json }},"title":{{ s.title | json }},"empty":{{ s.empty | json }},"checkout":{{ s.co | json }},"viewCart":{{ s.vc | json }}{%- if s.gb and s.gift -%},"gift":{"at":{{ s.thr | times: 100 }},"variant":{{ s.gift.selected_or_first_available_variant.id }},"title":{{ s.gift.title | json }},"msg":{{ s.msg | json }},"done":{{ s.unl | json }} }{%- endif -%}{%- if s.sb -%},"ship":{"at":{{ s.sat | times: 100 }},"msg":{{ s.sm | json }},"done":{{ s.sd | json }} }{%- endif -%}{%- if s.rw -%},"tiers":{"msg":{{ s.rm | json }},"done":{{ s.rd | json }},"list":[{"at":{{ s.a1 | times: 100 }},"label":{{ s.l1 | json }} }{%- if s.a2 > 0 -%},{"at":{{ s.a2 | times: 100 }},"label":{{ s.l2 | json }} }{%- endif -%}{%- if s.a3 > 0 -%},{"at":{{ s.a3 | times: 100 }},"label":{{ s.l3 | json }} }{%- endif -%}] }{%- endif -%}{%- if s.nt -%},"note":{"label":{{ s.nl | json }} },"code":{"label":{{ s.cl | json }},"apply":{{ s.ca | json }},"bad":{{ s.cb | json }} }{%- endif -%}
{%- if s.up -%},"upsell":{"source":"shopify","title":{{ s.uh | json }},"add":{{ s.add | json }},"limit":3 }{%- endif -%} }
</script>
</div>
<script src="{{ shop.secure_url }}/apps/blocko/drawer.js" defer></script>
{% schema %}
{"name":"Blocko Cart Drawer","enabled_on":{"groups":["header"]},"presets":[{"name":"Blocko Cart Drawer"}],"settings":[{"type":"text","id":"title","label":"Title ({count} = items)","default":"Your cart"},{"type":"text","id":"empty","label":"Empty text","default":"Your cart is empty"},{"type":"text","id":"co","label":"Checkout button","default":"Checkout"},{"type":"text","id":"vc","label":"Cart link","default":"View cart"},{"type":"checkbox","id":"gb","label":"Gift bar"},{"type":"number","id":"thr","label":"Min spend","default":50},{"type":"product","id":"gift","label":"Gift"},{"type":"text","id":"msg","label":"Progress","default":"Spend {amount} more for a free {gift}"},{"type":"text","id":"unl","label":"Unlocked","default":"You unlocked a free {gift}"},{"type":"paragraph","content":"Blocko only shows gift progress. Create an automatic Shopify discount (100% off the gift) so checkout matches."},{"type":"checkbox","id":"sb","label":"Free shipping bar"},{"type":"number","id":"sat","label":"Free shipping at","default":75},{"type":"text","id":"sm","label":"Shipping progress","default":"Spend {amount} more for free shipping"},{"type":"text","id":"sd","label":"Shipping reached","default":"You got free shipping"},{"type":"paragraph","content":"Blocko only shows progress. Create a free shipping rate in Shopify with the same minimum."},{"type":"checkbox","id":"rw","label":"Reward tiers"},{"type":"number","id":"a1","label":"Tier 1 at","default":50},{"type":"text","id":"l1","label":"Tier 1 reward","default":"Free shipping"},{"type":"number","id":"a2","label":"Tier 2 at","default":100},{"type":"text","id":"l2","label":"Tier 2 reward","default":"10% off"},{"type":"number","id":"a3","label":"Tier 3 at"},{"type":"text","id":"l3","label":"Tier 3 reward"},{"type":"text","id":"rm","label":"Tier progress","default":"Spend {amount} more for {next}"},{"type":"text","id":"rd","label":"Tiers reached","default":"All rewards unlocked"},{"type":"checkbox","id":"nt","label":"Order note and discount code"},{"type":"text","id":"nl","label":"Order note label","default":"Add a note to your order"},{"type":"text","id":"cl","label":"Discount code label","default":"Discount code"},{"type":"text","id":"ca","label":"Apply button","default":"Apply"},{"type":"text","id":"cb","label":"Invalid code text","default":"Not applicable"},{"type":"checkbox","id":"up","label":"Upsell","default":true},{"type":"text","id":"uh","label":"Upsell title","default":"Pairs well with"},{"type":"text","id":"add","label":"Add button","default":"Add"},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},{"type":"header","content":"Style"},{"type":"color","id":"ink","label":"Text color"},{"type":"color","id":"bg","label":"Background"},{"type":"color","id":"panel","label":"Progress bar background"},{"type":"color","id":"btn","label":"Checkout button color"},{"type":"color","id":"btc","label":"Checkout text color"},{"type":"range","id":"br","label":"Button roundness","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"fl","label":"Floating panel with rounded corners"}]}
{% endschema %}
