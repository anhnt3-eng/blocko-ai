<i hidden data-blko-block="tiered-rewards"></i>
<script src="{{ shop.secure_url }}/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign s = section.settings
  assign now = 'now' | date: '%s' | plus: 0
  assign types = 'milestone-reward,gift-with-cart-value,gift-with-quantity-purchase,gift-with-collection-value,shipping-goal,order-goal'
  assign camp = nil
  assign anyc = false
  if s.use_aov
    for c in shop.metafields.avada_free_gifts.giftCampaigns.value
      assign e = c.endDate | date: '%s' | plus: 0
      assign st = c.startDate | date: '%s' | plus: 0
      assign okc = false
      if c.status == 'active' and st <= now
        assign okc = true
      endif
      if c.enabledEndDate and e < now
        assign okc = false
      endif
      if okc
        assign anyc = true
      endif
      unless types contains c.type
        assign okc = false
      endunless
      if c.triggerType != 'cart-value' and 'milestone-reward,gift-with-cart-value' contains c.type
        assign okc = false
      endif
      if okc
        assign camp = c
        break
      endif
    endfor
  endif
  assign d = shop.metafields.avada_free_gifts.giftBoxDesignSetting.value
  assign head = s.header | default: 'Rewards'
  assign desc = s.desc
  assign pm = s.progress
  assign zm = s.done
  assign txc = '#333'
  assign pbg = '#fff'
  assign ptx = '#1c1c1c'
  assign dbg = '#1c1c1c'
  assign dtx = '#fff'
  assign amts = ''
  assign lbls = ''
  assign qty = false
  if camp
    assign head = s.header | default: d.headerText
    assign desc = s.desc | default: d.descriptionText
    assign pm = d.progressMessage | default: s.progress
    assign zm = d.promotionReachedMessage | default: s.done
    assign txc = d.primaryTextColor | default: txc
    assign pbg = d.inCompletedBgColor | default: pbg
    assign ptx = d.inCompletedTextColor | default: ptx
    assign dbg = d.completedBgColor | default: dbg
    assign dtx = d.completedIconColor | default: dtx
    assign tp = camp.triggerProducts | map: 'id'
    assign tcl = camp.triggerCollections | map: 'handle'
    assign ti = camp.discountInformation | sort: 'triggerValue'
    if camp.type == 'gift-with-quantity-purchase' or camp.type == 'order-goal' and camp.enabledTriggerQuantity
      assign qty = true
      assign pm = s.progress_qty
    endif
    if ti.size == 0 or camp.type != 'milestone-reward' and camp.type != 'gift-with-cart-value'
      if qty
        assign tv = camp.triggerQuantity | plus: 0
      else
        assign tv = camp.minimumTriggerValue | times: 100 | round
      endif
      if camp.discountType == 'percentage'
        assign disc = camp.discountValue | append: '%'
      else
        assign disc = camp.discountValue | times: 100 | money
      endif
      assign reward = camp.giftProducts.first.title | default: s.ship
      if camp.type == 'order-goal'
        assign reward = s.off | replace: '{discount}', disc
      endif
      assign amts = tv | append: '~'
      assign lbls = reward | append: '~'
      assign ti = nil
    endif
    for t in ti
      if t.discountType == 'percentage'
        assign disc = t.discountValue | append: '%'
      else
        assign disc = t.discountValue | times: 100 | money
      endif
      assign g = camp.giftProducts[forloop.index0]
      if g
        assign reward = g.title
      else
        assign reward = t.rewardMessage | replace: '{{discount}}', disc
      endif
      assign tv = t.triggerValue | times: 100 | round
      assign amts = amts | append: tv | append: '~'
      assign lbls = lbls | append: reward | append: '~'
    endfor
  elsif anyc == false
    assign v1 = s.a1 | times: 100 | round
    assign v2 = s.a2 | times: 100 | round
    assign v3 = s.a3 | times: 100 | round
    assign amts = v1 | append: '~' | append: v2 | append: '~' | append: v3 | append: '~'
    assign lbls = s.l1 | append: '~' | append: s.l2 | append: '~' | append: s.l3 | append: '~'
  endif
  assign al = amts | split: '~'
  assign ll = lbls | split: '~'
-%}
{%- if al.size > 0 -%}
<div class="blko-tr" id="blko-tr-{{ section.id }}">
<style>.blko-tr{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit;color:{{ txc }}}.blko-tr h3{margin:0}.blko-tr p{margin:0 0 8px}.blko-tr ul{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:8px}.blko-tr li{display:flex;justify-content:space-between;gap:8px;padding:12px;border-radius:12px;border:1px solid rgba(0,0,0,.12);background:{{ pbg }};color:{{ ptx }}}.blko-tr li.ok{background:{{ dbg }};color:{{ dtx }}}</style><h3>{{ head | escape }}</h3><p>{{ desc | escape }}</p><p></p><ul>
{%- for a in al -%}
{%- assign cents = a | plus: 0 -%}
{%- if cents > 0 -%}
{%- liquid
  assign amt = cents | money
  assign row = s.spend | replace: '{amount}', amt
  if qty
    assign row = s.spend_qty | replace: '{amount}', cents
  endif
  assign lb = ll[forloop.index0]
-%}<li data-a="{{ cents }}"><span>{{ row | escape }}{% if lb != blank %}: {{ lb | escape }}{% endif %}</span><em></em></li>
{%- endif -%}
{%- endfor -%}</ul>
</div>
<script>(()=>{const r=document.getElementById('blko-tr-{{ section.id }}'),R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',F={{ shop.money_format | json }},P={{ pm | json }},Z={{ zm | json }},G={{ s.togo | json }},Q={{ qty | json }},IH=({{ tp | json }}||[]).map(Number),CH={{ tcl | json }}||[],S=new Set(IH);
let q;const m=c=>Q?c:F.replace(/\{\{\s*\w+\s*\}\}/,(c/100).toFixed(2)),
u=async()=>{try{if(CH.length&&!S.size)for(const h of CH)try{(await(await fetch(R+'collections/'+h+'/products.json?limit=250')).json()).products.forEach(x=>S.add(x.id))}catch(e){}
const v=(await(await fetch(R+'cart.js')).json()).items.filter(i=>!(i.properties&&(i.properties._aovCampId||i.properties._blko_gift))&&(!(IH.length+CH.length)||S.has(i.product_id))).reduce((a,i)=>a+(Q?i.quantity:i.original_line_price),0);let n;
r.querySelectorAll('li').forEach(l=>{const a=+l.dataset.a,k=v>=a;l.classList.toggle('ok',k);l.lastChild.textContent=k?'✓':G.replace('{amount}',m(a-v));if(!k&&!n)n=a});
r.querySelector('p+p').textContent=n?P.replace(/\{\{?(?:progress_amount|amount)\}\}?/,m(n-v)).replace(/\{\{?gift_number\}\}?/,'1'):Z}catch(e){}},
w=()=>{clearTimeout(q);q=setTimeout(u,350)};
new PerformanceObserver(l=>l.getEntries().some(e=>/\/cart\/(add|change|update)/.test(e.name))&&w()).observe({entryTypes:['resource']});
['cart:updated','cart:refresh','blko:cart:changed'].forEach(e=>document.addEventListener(e,w));u()})()</script>
{%- endif -%}
{% schema %}
{"name":"Blocko Tiered Rewards","enabled_on":{"templates":["cart","product"]},"presets":[{"name":"Blocko Tiered Rewards"}],"settings":[{"type":"paragraph","content":"Two modes. AOV mode: with an active AOV.ai campaign (milestone, cart value, quantity, collection, shipping or order goal) it lists its tiers and progress; nothing shows if the active campaign has no tiers. Settings mode: up to 3 tiers below, smallest amount first. It only DISPLAYS tiers; create the matching Shopify discounts or gifts so checkout delivers them."},{"type":"checkbox","id":"use_aov","label":"Use the AOV.ai campaign when there is one","default":true},{"type":"text","id":"header","label":"Header (blank = AOV.ai / Rewards)"},{"type":"text","id":"desc","label":"Description (blank = AOV.ai)"},{"type":"text","id":"spend","label":"Tier label","default":"Spend {amount}"},{"type":"text","id":"spend_qty","label":"AOV tier label (items)","default":"Buy {amount} items"},{"type":"text","id":"progress_qty","label":"Progress text (items)","default":"Add {amount} more items for your next reward"},{"type":"text","id":"ship","label":"AOV shipping reward","default":"Free shipping"},{"type":"text","id":"off","label":"AOV discount reward","default":"{discount} off"},{"type":"text","id":"togo","label":"To go text","default":"{amount} to go"},{"type":"text","id":"progress","label":"Progress text","default":"Spend {amount} more for your next reward"},{"type":"text","id":"done","label":"All unlocked text","default":"You unlocked every reward"},{"type":"number","id":"a1","label":"Tier 1 amount (shop currency)","default":30},{"type":"text","id":"l1","label":"Tier 1 reward","default":"Free shipping"},{"type":"number","id":"a2","label":"Tier 2 amount"},{"type":"text","id":"l2","label":"Tier 2 reward"},{"type":"number","id":"a3","label":"Tier 3 amount"},{"type":"text","id":"l3","label":"Tier 3 reward"}]}
{% endschema %}
