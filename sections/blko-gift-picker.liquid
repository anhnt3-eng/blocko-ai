<i hidden data-blko-block="gift-picker"></i>
<script src="/apps/blocko/beacon.js" defer></script>
<style>
.blko-gp{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit}
.blko-gp .g{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
.blko-gp .c{display:flex;flex-direction:column;gap:6px;padding:12px;border:2px solid rgba(0,0,0,.12);border-radius:12px;background:#fff;color:#17151d}
.blko-gp .on{border-color:var(--c)}
.blko-gp img{width:100%;height:auto;}.blko-gp s{opacity:.6}.blko-gp b{color:#1a7f4b}
.blko-gp button{margin-top:auto;padding:10px;border:0;border-radius:99px;background:var(--c);color:#fff;font:inherit}
.blko-gp button:disabled{opacity:.6}
</style>
{% assign o = section.settings %}<div class="blko-gp" id="blko-gp-{{ section.id }}" style="--c:{{ o.color }}" data-min="{{ o.min | times: 100 }}">
<h2>{{ o.heading }}</h2>
<p hidden></p><div class="g" hidden>{% for i in (1..3) %}{% assign k = 'gift_' | append: i %}{% assign p = o[k] %}
{% if p != blank %}{% assign v = p.variants | where: 'available' | first %}
{% if v %}<div class="c" data-v="{{ v.id }}">{% if p.featured_image %}<img width="200" height="200" src="{{ p.featured_image | image_url: width: 200 }}" alt="">{% endif %}
<strong>{{ p.title }}</strong><span><s>{{ v.price | money }}</s> <b>{{ o.free }}</b></span>
<button>{{ o.choose }}</button></div>{% endif %}{% endif %}{% endfor %}
</div></div>
<script>(()=>{var s=document.getElementById('blko-gp-{{ section.id }}'),r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',mn=+s.dataset.min,L={{ o.locked | json }},C={{ o.choose | json }},H={{ o.chosen | json }},mf={{ shop.money_format | json }},lk=s.querySelector('p'),g=s.querySelector('.g');
function $(c){return window.Shopify&&Shopify.formatMoney?Shopify.formatMoney(c,mf):(c/100).toFixed(2)}
function j(u,b){return fetch(r+u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(x=>{if(!x.ok)throw 0})}
function rm(a){return a.reduce((p,i)=>p.then(()=>j('cart/change.js',{id:i.key,quantity:0})),Promise.resolve())}
function gf(i){return(i.properties||{})._blko_gift==='1'}
fetch(r+'cart.js').then(x=>x.json()).then(c=>{var gs=c.items.filter(gf),sub=c.items.reduce((t,i)=>t+(gf(i)?0:i.final_line_price),0);
if(sub<mn){g.hidden=true;lk.hidden=false;lk.textContent=L.replace('{amount}',$(mn-sub));if(gs.length)rm(gs).then(()=>location.reload());return}
lk.hidden=!(g.hidden=false);
s.querySelectorAll('.c').forEach(e=>{var b=e.querySelector('button'),on=gs.some(i=>i.variant_id==e.dataset.v);e.classList.toggle('on',on);b.textContent=on?H:C;
b.disabled=on;b.onclick=()=>{b.disabled=true;j('cart/add.js',{items:[{id:+e.dataset.v,quantity:1,properties:{_blko_gift:'1'}}]}).then(()=>rm(gs)).then(()=>location.reload()).catch(()=>{b.disabled=false})}})})})();</script>
{% schema %}
{"name":"Blocko Gift Picker","enabled_on":{"templates":["cart"]},"presets":[{"name":"Blocko Gift Picker"}],
"settings":[
{"type":"text","id":"heading","label":"Heading","default":"Choose your free gift"},
{"type":"number","id":"min","label":"Minimum spend","default":75},
{"type":"product","id":"gift_1","label":"Gift 1"},
{"type":"product","id":"gift_2","label":"Gift 2"},
{"type":"product","id":"gift_3","label":"Gift 3"},
{"type":"text","id":"choose","label":"Choose label","default":"Choose"},
{"type":"text","id":"chosen","label":"Chosen label","default":"Chosen"},
{"type":"text","id":"free","label":"Free label","default":"Free"},
{"type":"text","id":"locked","label":"Locked text","default":"Spend {amount} more to choose a free gift"},
{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},
{"type":"paragraph","content":"Create an automatic discount: 100% off these gift products with the same minimum spend, so checkout charges 0."}]}
{% endschema %}
