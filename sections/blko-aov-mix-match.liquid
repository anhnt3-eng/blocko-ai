<i hidden data-blko-block="aov-mix-match"></i>
<script src="/apps/blocko/beacon.js" defer></script>
<div class="blko-am" id="blko-am-{{ section.id }}" style="--c:{{ section.settings.color }}" hidden>
<style>.blko-am{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit}.blko-am>*{max-width:560px}.blko-am h3{margin:16px 0 8px;font-size:1em}.blko-am .r{display:flex;align-items:center;gap:10px;padding:8px 12px;margin-bottom:8px;background:#fff;color:#111;border:1px solid rgba(0,0,0,.12);border-radius:12px;cursor:pointer}.blko-am .r:has(input:checked){border-color:var(--c)}.blko-am input{accent-color:var(--c)}.blko-am img{width:48px;height:48px;border-radius:8px;object-fit:cover}.blko-am .g{flex:1}.blko-am p{margin:16px 0}.blko-am button{width:100%;padding:12px;border:0;border-radius:99px;background:var(--c);color:#fff;font:inherit;cursor:pointer}</style>
<h2></h2><div></div><p></p>
<button type="button">{{ section.settings.button }}</button></div>
<script>(()=>{
const s=document.getElementById('blko-am-{{ section.id }}'),R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',J={'Content-Type':'application/json'},
M={{ shop.money_format | json }},b=s.querySelector('button'),L=s.querySelector('div'),T=b.textContent,
m=c=>M.replace(/\{\{\s*\w+\s*\}\}/,(c/100).toFixed(2)),
e=(g,x,p)=>{const n=document.createElement(g);n.textContent=x||'';p.appendChild(n);return n};
(async()=>{let o;try{let a={{ shop.metafields.avada_bundle.mixMatchOffers.value | json }};if(!a||a.error)a={{ shop.metafields.avada_bundle.mixMatchOffers | json }};
if(typeof a==='string')a=JSON.parse(a);a=(Array.isArray(a)?a:a&&a.id?[a]:Object.values(a||{})).map(x=>x&&x.setting||x);
o=a.find(x=>x&&x.status==='active'&&x.mixMatchProductHandle==='{{ product.handle }}')}catch(x){}
if(!o)return;
const G=await Promise.all((o.bundleOptions||[]).map(async g=>{const l=[];for(const p of g.products||[]){try{const j=await(await fetch(R+'products/'+p.handle+'.js')).json(),v=j.variants.find(v=>v.available);if(v)l.push({j,v,q:p.quantity||1})}catch(x){}}return{n:g.optionName,l}}));
const K=G.map(()=>0),tot=()=>G.reduce((a,g,i)=>{const c=g.l[K[i]];return a+(c?c.v.price*c.q:0)},0);
const upd=()=>{const t=tot(),pc=o.discountType==='percentage',d=Math.min(t,pc?t*o.discountValue/100:o.discountValue*100);
s.querySelector('p').textContent='Total now '+m(t-d)+', you save '+m(d)};
s.querySelector('h2').textContent=o.offerTitle||'';
G.forEach((g,i)=>{e('h3',g.n,L);g.l.forEach((c,k)=>{const l=e('label',0,L),r=e('input',0,l),im=e('img',0,l),x=e('span',0,l);l.className='r';r.type='radio';r.name='am'+i;r.checked=k==0;r.onchange=()=>{K[i]=k;upd()};
if(c.j.featured_image){im.src=c.j.featured_image;im.alt=''}x.className='g';x.textContent=c.j.title;e('strong',m(c.v.price*c.q),l)})});
upd();s.hidden=false;
b.onclick=async()=>{b.disabled=true;try{const n=Array.from({length:3},()=>String.fromCharCode(65+Math.random()*26|0)).join(''),
items=G.map((g,i)=>({id:g.l[K[i]].v.id,quantity:g.l[K[i]].q,properties:{_aov_offerId:o.id,_aov_offerType:'mix-match-bundle',_aov_bundleGroup:o.id+'|'+n+'|'+i}})),
a=await fetch(R+'cart/add.js',{method:'POST',headers:J,body:JSON.stringify({items})});if(!a.ok)throw await a.json();
if(o.code){const c=(await(await fetch(R+'cart.js')).json()).discount_codes.map(d=>d.code);if(!c.includes(o.code))c.push(o.code);
await fetch(R+'cart/update.js',{method:'POST',headers:J,body:JSON.stringify({discount:c.join(',')})})}
location.href=R+'cart'}catch(x){b.disabled=false;b.textContent=x.description||T}}})()})();</script>
{% schema %}
{"name":"Blocko AOV Mix & Match","enabled_on":{"templates":["product"]},"presets":[{"name":"Blocko AOV Mix & Match"}],"settings":[{"type":"paragraph","content":"Shows the AOV.ai Mix & match offer on its bundle product page. Turn off AOV.ai's widget to avoid a duplicate."},
{"type":"text","id":"button","label":"Button text","default":"Add bundle to cart"},
{"type":"color","id":"color","label":"Accent color","default":"#6538bd"}]}
{% endschema %}
