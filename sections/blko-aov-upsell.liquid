<i hidden data-blko-block="aov-upsell"></i>
<script src="/apps/blocko/beacon.js" defer></script>
<div class="blko-up" id="blko-up-{{ section.id }}" style="--c:{{ section.settings.color }}" hidden>
<style>.blko-up{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit}.blko-up[hidden]{display:none}.blko-up .l{display:grid;gap:10px;max-width:560px}.blko-up .r{display:flex;align-items:center;gap:12px;padding:10px 14px;background:#fff;color:#17151d;border:1px solid rgba(0,0,0,.12);border-radius:12px}.blko-up img{width:64px;height:64px;object-fit:cover;border-radius:8px}.blko-up .g{flex:1;min-width:0;display:grid;gap:2px}.blko-up a{color:inherit;text-decoration:none;font-weight:600}.blko-up .g span{opacity:.7;font-size:.9em}.blko-up button{padding:9px 18px;border:0;border-radius:99px;background:var(--c);color:#fff;font:inherit;cursor:pointer}.blko-up button:disabled{opacity:.7;cursor:default}</style>
<h2></h2><div class="l"></div></div>
<script>(()=>{
const s=document.getElementById('blko-up-{{ section.id }}'),L=s.querySelector('.l'),R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',
M={{ shop.money_format | json }},A={{ section.settings.add | json }},D={{ section.settings.added | json }},W={{ section.settings.price_text | json }},
m=c=>M.replace(/\{\{\s*\w+\s*\}\}/,(c/100).toFixed(2)),
e=(g,x,p)=>{const n=document.createElement(g);n.textContent=x||'';p.appendChild(n);return n};
let o;try{o={{ shop.metafields.avada_bundle.offer | json }};if(typeof o==='string')o=JSON.parse(o);
o=(o||[]).find(x=>x.type==='upsell'&&x.page==='product_page'&&x.status==='active'&&(x.triggerCondition==='all-products'||(x.triggerProducts||[]).some(p=>String(p.id)==='{{ product.id }}')))}catch(x){}
if(!o)return;
const U=(o.upsellProducts||[]).filter(u=>u.handle!=='{{ product.handle }}').slice(0,o.productsPerPage||3),
pc=o.discountType==='percentage';
Promise.all(U.map(u=>fetch(R+'products/'+u.handle+'.js').then(r=>r.json()).catch(()=>0))).then(a=>{
a=a.filter(p=>p&&p.variants.some(v=>v.available));if(!a.length)return;
s.querySelector('h2').textContent=o.offerTitle||'';
a.forEach(p=>{const v=p.variants.find(v=>v.available),d=document.createElement('div'),t=e('div',0,d),b=document.createElement('button');
d.className='r';t.className='g';
if(p.featured_image){const i=document.createElement('img');i.alt='';i.width=i.height=160;i.src=p.featured_image+(p.featured_image.indexOf('?')<0?'?':'&')+'width=160';d.insertBefore(i,t)}
const l=e('a',p.title,t);l.href=p.url;
let x=m(v.price);
if(o.enabledDiscount){const n=pc?v.price*(100-o.discountValue)/100:Math.max(0,v.price-o.discountValue*100);x=W.replace('[was]',m(v.price)).replace('[now]',m(n))}
e('span',x,t);
b.type='button';b.textContent=A;d.appendChild(b);
b.onclick=()=>{b.disabled=true;fetch(R+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:v.id,quantity:1,properties:{_aov_bundles:JSON.stringify({offerId:o.id,isUpsell:true})}}]})}).then(r=>{if(!r.ok)throw 0;b.textContent=D;document.dispatchEvent(new CustomEvent('blko:cart:changed'))}).catch(()=>{b.disabled=false})};
L.appendChild(d)});
s.hidden=false}).catch(()=>{})})();</script>
{% schema %}
{"name":"Blocko AOV Upsell","enabled_on":{"templates":["product"]},"presets":[{"name":"Blocko AOV Upsell"}],"settings":[{"type":"paragraph","content":"Shows AOV.ai Product recommendation offers for this product. Turn off AOV.ai's widget to avoid a duplicate."},
{"type":"text","id":"add","label":"Add button text","default":"+ Add"},
{"type":"text","id":"added","label":"Added button text","default":"Added"},
{"type":"text","id":"price_text","label":"Discount price text","default":"Was [was], now [now]"},
{"type":"color","id":"color","label":"Accent color","default":"#6538bd"}]}
{% endschema %}
