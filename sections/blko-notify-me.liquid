<i hidden data-blko-block="notify-me"></i>
<script src="{{ shop.secure_url }}/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign blko_show = true
  if product and section.settings.only_collection != blank
    assign blko_show = false
    for blko_c in product.collections
      if blko_c.id == section.settings.only_collection.id
        assign blko_show = true
        break
      endif
    endfor
  endif
  if product and blko_show and section.settings.only_tag != blank
    assign blko_tag = section.settings.only_tag | strip | downcase
    assign blko_show = false
    for blko_t in product.tags
      assign blko_tt = blko_t | downcase
      if blko_tt == blko_tag
        assign blko_show = true
        break
      endif
    endfor
  endif
-%}
{%- if blko_show -%}
{%- assign v0 = product.selected_or_first_available_variant -%}
<div class="blko-nm" id="blko-nm-{{ section.id }}" hidden>
<style>
#blko-nm-{{ section.id }}{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit;--c:{{ section.settings.color }}}
#blko-nm-{{ section.id }} .b{max-width:440px;padding:20px;border:1px solid rgba(0,0,0,.12);border-radius:12px}
#blko-nm-{{ section.id }} h3{margin:0 0 6px;font-size:18px}
#blko-nm-{{ section.id }} p{margin:0 0 12px;opacity:.75;font-size:14px}
#blko-nm-{{ section.id }} form{display:flex;flex-wrap:wrap;gap:8px}
#blko-nm-{{ section.id }} input{flex:1 1 180px;min-width:0;padding:11px 12px;border:1px solid rgba(0,0,0,.12);border-radius:12px;font:inherit}
#blko-nm-{{ section.id }} button{padding:11px 18px;border:0;border-radius:12px;background:var(--c);color:#fff;font:inherit;font-weight:600;cursor:pointer}
#blko-nm-{{ section.id }} button:disabled{opacity:.6}
#blko-nm-{{ section.id }} .m{margin-top:10px;font-size:14px}
</style>
<div class="b">
<h3>{{ section.settings.heading }}</h3>
<p>{{ section.settings.text }}</p>
<form novalidate>
<input type="email" required autocomplete="email" placeholder="{{ section.settings.placeholder }}" value="{{ customer.email }}" aria-label="{{ section.settings.placeholder }}">
<button type="submit">{{ section.settings.button }}</button>
</form>
<div class="m" role="status"></div>
</div>
</div>
<script>
(function(){
var r=document.getElementById('blko-nm-{{ section.id }}'),V={{ product.variants | json }},
R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',
f=r.querySelector('form'),m=r.querySelector('.m'),b=f.querySelector('button'),last;
function cur(){var e=document.querySelector('form[action*="/cart/add"] [name="id"]'),
id=(e&&e.value)||new URLSearchParams(location.search).get('variant')||'{{ v0.id }}';
return V.filter(function(v){return String(v.id)===String(id)})[0]}
function sync(){var v=cur();if(!v||v.id===last)return;last=v.id;r.hidden=v.available;m.textContent=''}
sync();setInterval(sync,400);document.addEventListener('change',sync);
f.addEventListener('submit',function(e){e.preventDefault();var v=cur(),i=f.querySelector('input');
if(!v||!i.value||!i.checkValidity()){m.textContent={{ section.settings.error | json }};return}
b.disabled=true;
fetch(R+'apps/blocko/notify',{method:'POST',headers:{'Content-Type':'application/json'},
body:JSON.stringify({email:i.value,variantId:String(v.id),productId:'{{ product.id }}'})})
.then(function(x){m.textContent=x.ok?{{ section.settings.success | json }}:{{ section.settings.error | json }};if(x.ok)f.reset()})
.catch(function(){m.textContent={{ section.settings.error | json }}})
.then(function(){b.disabled=false})});
})();
</script>
{%- endif -%}
{% schema %}
{"name":"Blocko Notify Me","settings":[{"type":"text","id":"heading","label":"Heading","default":"Sold out"},{"type":"text","id":"text","label":"Text","default":"Leave your email and we will tell you when it is back."},{"type":"text","id":"placeholder","label":"Email placeholder","default":"you@email.com"},{"type":"text","id":"button","label":"Button text","default":"Notify me"},{"type":"text","id":"success","label":"Success message","default":"Thanks! We will email you."},{"type":"text","id":"error","label":"Error message","default":"Please enter a valid email."},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},{"type":"header","content":"Show on"},{"type":"collection","id":"only_collection","label":"Only products in this collection","info":"Leave both empty to show on every product."},{"type":"text","id":"only_tag","label":"Only products with this tag"}],"presets":[{"name":"Blocko Notify Me"}],"enabled_on":{"templates":["product"]}}
{% endschema %}
