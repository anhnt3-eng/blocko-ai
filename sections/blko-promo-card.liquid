<i hidden data-blko-block="promo-card"></i>
<script src="{{ shop.secure_url }}/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign blko_show = true
  if product and section.settings.only_collection != blank
    assign blko_show = false
    for blko_c in product.collections
      if blko_c.id == section.settings.only_collection.id
        assign blko_show = true
        break
      endif
    endfor
  endif
  if product and blko_show and section.settings.only_tag != blank
    assign blko_tag = section.settings.only_tag | strip | downcase
    assign blko_show = false
    for blko_t in product.tags
      assign blko_tt = blko_t | downcase
      if blko_tt == blko_tag
        assign blko_show = true
        break
      endif
    endfor
  endif
-%}
{%- if blko_show -%}
{%- assign s = section.settings -%}
{%- assign ok = true -%}
{%- assign today = 'now' | date: '%Y-%m-%d' | remove: '-' | plus: 0 -%}
{%- if s.end != blank -%}{%- assign e = s.end | remove: '-' | plus: 0 -%}{%- if e < today -%}{%- assign ok = false -%}{%- endif -%}{%- endif -%}
{%- if s.collection != blank -%}{%- assign inc = false -%}{%- for c in product.collections -%}{%- if c.id == s.collection.id -%}{%- assign inc = true -%}{%- endif -%}{%- endfor -%}{%- unless inc -%}{%- assign ok = false -%}{%- endunless -%}{%- endif -%}
{%- if ok -%}
<style>
.blko-pc{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit}
.blko-pc .c{max-width:520px;padding:20px;background:#fff;color:#17151d;border:1px solid rgba(0,0,0,.12);border-radius:12px}
.blko-pc .t{display:inline-block;padding:3px 10px;border-radius:99px;background:var(--c);color:#fff;font-size:12px}
.blko-pc h2{margin:10px 0 6px;font-size:22px}.blko-pc p{margin:0}
.blko-pc .k{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:16px}
.blko-pc code{padding:8px 12px;border:1px dashed var(--c);border-radius:8px;font-weight:700;letter-spacing:.05em}
.blko-pc button,.blko-pc a{padding:8px 16px;border:1px solid var(--c);border-radius:99px;background:none;color:var(--c);font:inherit;cursor:pointer;text-decoration:none}
.blko-pc a{background:var(--c);color:#fff}
</style>
<div class="blko-pc" id="blko-pc-{{ section.id }}" data-end="{{ s.end | escape }}" style="--c:{{ s.color }}">
<div class="c">
{%- if s.badge != blank -%}<span class="t">{{ s.badge }}</span>{%- endif -%}
<h2>{{ s.heading }}</h2>
{%- if s.body != blank -%}<p>{{ s.body }}</p>{%- endif -%}
{%- if s.code != blank -%}
<div class="k"><code>{{ s.code | escape }}</code><button type="button">{{ s.copy }}</button><a href="{{ routes.root_url }}discount/{{ s.code | url_encode }}?redirect={{ product.url | url_encode }}">{{ s.apply }}</a></div>
{%- endif -%}
</div>
</div>
<script>(function(){var s=document.getElementById('blko-pc-{{ section.id }}'),e=s.dataset.end,b=s.querySelector('button'),c=s.querySelector('code');
if(e&&new Date().toLocaleDateString('en-CA')>e){s.remove();return}
if(!b)return;b.onclick=function(){var t=c.textContent,o=b.textContent;
function ok(){b.textContent={{ s.copied | json }};setTimeout(function(){b.textContent=o},1500)}
function fb(){getSelection().selectAllChildren(c);try{document.execCommand('copy')&&ok()}catch(x){}}
if(navigator.clipboard)navigator.clipboard.writeText(t).then(ok,fb);else fb()}})();</script>
{%- endif -%}
{%- endif -%}
{% schema %}
{"name":"Blocko Promo Card","enabled_on":{"templates":["product"]},"presets":[{"name":"Blocko Promo Card"}],"settings":[{"type":"text","id":"badge","label":"Badge","default":"Limited offer"},{"type":"text","id":"heading","label":"Heading","default":"Buy 2, get 10% off"},{"type":"textarea","id":"body","label":"Body text","default":"Add two to your cart and save."},{"type":"text","id":"code","label":"Discount code (optional)"},{"type":"text","id":"copy","label":"Copy button","default":"Copy"},{"type":"text","id":"copied","label":"Copied text","default":"Copied"},{"type":"text","id":"apply","label":"Apply link text","default":"Apply"},{"type":"text","id":"end","label":"End date (optional)","info":"YYYY-MM-DD. Card hides after this date."},{"type":"collection","id":"collection","label":"Only show for collection (optional)"},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},{"type":"paragraph","content":"This card is display only. Create the matching discount code in Shopify (Discounts) so checkout applies the offer."},{"type":"header","content":"Show on"},{"type":"collection","id":"only_collection","label":"Only products in this collection","info":"Leave both empty to show on every product."},{"type":"text","id":"only_tag","label":"Only products with this tag"}]}
{% endschema %}
