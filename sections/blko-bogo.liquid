<i hidden data-blko-block="bogo"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{%- assign v = product.selected_or_first_available_variant -%}
{%- capture im -%}{%- if product.featured_image -%}<img width="56" height="56" src="{{ product.featured_image | image_url: width: 56 }}" alt="">{%- endif -%}{%- endcapture -%}
<style>
.blko-bg{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit}
.blko-bg>*{max-width:520px}.blko-bg h2{margin:0 0 20px}
.blko-bg .r{position:relative;display:flex;align-items:center;gap:10px;padding:12px 14px;margin-bottom:14px;background:#fff;color:#17151d;border:1px solid rgba(0,0,0,.12);border-radius:12px;cursor:pointer}
.blko-bg .r:has(input:checked){border-color:var(--c)}
.blko-bg input{accent-color:var(--c)}.blko-bg .g{flex:1}.blko-bg img{width:28px;height:28px;border-radius:8px;object-fit:cover;vertical-align:middle;margin:6px 4px 0 0}
.blko-bg .t{position:absolute;top:-9px;right:14px;background:var(--c);color:#fff;font-size:10px;padding:2px 9px;border-radius:99px}
.blko-bg b{color:#1a7f4b;font-size:10px}
.blko-bg button{width:100%;padding:12px;border:0;border-radius:99px;background:#17151d;color:#fff;font:inherit;cursor:pointer}
</style>
<div class="blko-bg" id="blko-bg-{{ section.id }}" style="--c:{{ section.settings.color }}">
{%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
<label class="r"><input type="radio" name="g{{ section.id }}" value="1"><span class="g"><strong>{{ section.settings.l1 }}</strong></span><strong>{{ v.price | money }}</strong></label>
<label class="r">{%- if section.settings.tag != blank -%}<span class="t">{{ section.settings.tag }}</span>{%- endif -%}
<input type="radio" name="g{{ section.id }}" value="3" checked><span class="g"><strong>{{ section.settings.l2 }}</strong><br>{{ im }}{{ im }}{{ im }}<b>{{ section.settings.free }}</b></span>
<s>{{ v.price | times: 3 | money }}</s><strong>{{ v.price | times: 2 | money }}</strong></label>
<button type="button">{{ section.settings.button }}</button>
</div>
<script>(()=>{var s=document.getElementById('blko-bg-{{ section.id }}'),b=s.querySelector('button'),r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',t=b.textContent;
b.onclick=()=>{var f=document.querySelector('form[action*="/cart/add"] [name=id]');b.disabled=true;
fetch(r+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:f&&f.value||{{ v.id }},quantity:+s.querySelector('input:checked').value})}).then(x=>x.json().then(j=>{if(!x.ok)throw j;location.href=r+'cart'})).catch(e=>{b.disabled=false;b.textContent=e.description||t})}})();</script>
{% schema %}
{"name":"Blocko Buy 2 Get 1","enabled_on":{"templates":["product"]},"presets":[{"name":"Blocko Buy 2 Get 1"}],
"settings":[
{"type":"text","id":"heading","label":"Heading","default":"Special offer"},
{"type":"text","id":"l1","label":"Option 1 label","default":"Buy 1"},
{"type":"text","id":"l2","label":"Option 2 label","default":"Buy 2, get 1 free"},
{"type":"text","id":"tag","label":"Option 2 tag","default":"Deal"},
{"type":"text","id":"free","label":"Free item label","default":"1 FREE"},
{"type":"text","id":"button","label":"Button text","default":"Add to cart"},
{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},
{"type":"paragraph","content":"The free item is display only. Create a Shopify automatic discount (Buy X get Y free) for this product so checkout charges the price shown."}]}
{% endschema %}
