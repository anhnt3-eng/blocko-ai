<i hidden data-blko-block="review-summary"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign blko_show = true
  if product and section.settings.only_collection != blank
    assign blko_show = false
    for blko_c in product.collections
      if blko_c.id == section.settings.only_collection.id
        assign blko_show = true
        break
      endif
    endfor
  endif
  if product and blko_show and section.settings.only_tag != blank
    assign blko_tag = section.settings.only_tag | strip | downcase
    assign blko_show = false
    for blko_t in product.tags
      assign blko_tt = blko_t | downcase
      if blko_tt == blko_tag
        assign blko_show = true
        break
      endif
    endfor
  endif
-%}
{%- if blko_show -%}
{%- if product -%}
<div class="blko-rv" id="blko-reviews" hidden style="--c:{{ section.settings.color }}">
<div class="blko-rv__in" id="blko-rv-{{ section.id }}">
<h2>{{ section.settings.heading | escape }}</h2>
<p hidden>{{ section.settings.empty | escape }}</p>
<div class="blko-rv__top"><b></b><span class="blko-rv__s"><i></i></span><small></small></div>
<div class="blko-rv__bars"></div>
<ul></ul>
</div>
</div>
<script>
(function () {
var root = document.getElementById('blko-rv-{{ section.id }}');
if (!root) return;
var $ = function (s) { return root.querySelector(s); };
var el = function (p, tag, cls, txt) {
var n = document.createElement(tag);
n.className = cls || '';
n.textContent = txt || '';
p.appendChild(n);
return n;
};
var url = ((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'apps/blocko/reviews?product_id={{ product.id }}';
fetch(url, {headers: {Accept: 'application/json'}}).then(function (r) {
if (!r.ok) throw r;
return r.json();
}).then(function (d) {
if (!d.connected) throw 0;
root.parentNode.hidden = false;
if (!d.count) { $('p').hidden = false; $('.blko-rv__top').hidden = true; return; }
var l = d.reviews || [], q = $('.blko-rv__bars');
$('b').textContent = d.average;
$('i').style.width = d.average * 20 + '%';
$('small').textContent = d.count + ' {{ section.settings.label | escape }}';
for (var n = 5; n > 0; n--) {
var p = Math.round(l.filter(function (r) { return r.rating === n; }).length / (l.length || 1) * 100);
var w = el(q, 'div', 'blko-rv__row');
el(w, 'small', '', n + '★');
el(el(w, 'span', 'blko-rv__bar'), 'span').style.width = p + '%';
el(w, 'small', '', p + '%');
}
l.slice().sort(function (a, b) { return a.date < b.date ? 1 : -1; }).slice(0,3).forEach(function (r) {
var li = el($('ul'), 'li');
el(el(li, 'span', 'blko-rv__s'), 'i').style.width = r.rating * 20 + '%';
el(li, 'small', '', r.author + ' · ' + r.date);
el(li, 'strong', '', r.title);
el(li, 'p', '', r.body);
});
}).catch(function () { root.parentNode.hidden = true; });
})();
</script>
{%- endif -%}
<style>
.blko-rv[hidden], .blko-rv [hidden] { display: none; }
.blko-rv__in { max-width: 1200px; margin-inline: auto; padding: 40px 16px; }
.blko-rv__top { display: flex; align-items: center; gap: 12px; }
.blko-rv__top b { font-size: 48px; line-height: 1; }
.blko-rv__s { position: relative; display: inline-block; color: #ddd; }
.blko-rv__s::before, .blko-rv__s i::before { content: "★★★★★"; }
.blko-rv__s i { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: var(--c); }
.blko-rv__row { display: grid; grid-template-columns: 28px 1fr 40px; align-items: center; gap: 8px; margin-top: 6px; }
.blko-rv__bar { height: 8px; border-radius: 4px; background: rgba(0,0,0,.08); }
.blko-rv__bar span { display: block; height: 100%; background: var(--c); }
.blko-rv ul { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 12px; }
.blko-rv li { padding: 16px; border: 1px solid rgba(0,0,0,.12); border-radius: 12px; display: grid; gap: 4px; }
.blko-rv li p { margin: 0; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
@media (min-width: 750px) { .blko-rv ul { grid-template-columns: repeat(3, 1fr); } }
</style>
{%- endif -%}
{% schema %}
{"name":"Blocko Review Summary","settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer reviews"},{"type":"text","id":"label","label":"Reviews word","default":"reviews"},{"type":"text","id":"empty","label":"Empty text","default":"No reviews yet."},{"type":"color","id":"color","label":"Accent","default":"#6538bd"},{"type":"header","content":"Show on"},{"type":"collection","id":"only_collection","label":"Only products in this collection","info":"Leave both empty to show on every product."},{"type":"text","id":"only_tag","label":"Only products with this tag"}],"presets":[{"name":"Blocko Review Summary"}],"enabled_on":{"templates":["product"]}}
{% endschema %}
