<i hidden data-blko-block="photo-reviews"></i>
<script src="/apps/blocko/beacon.js" defer></script>
{%- if product -%}
<div class="blko-pr" id="blko-pr-{{ section.id }}" hidden style="--c:{{ section.settings.color }}">
  <h2>{{ section.settings.heading | escape }}</h2>
  <div class="blko-pr__grid"></div>
  <dialog class="blko-pr__dlg">
    <button type="button" class="blko-pr__x" aria-label="{{ section.settings.close | escape }}">&times;</button>
    <img width="600" height="600" alt="">
    <span class="blko-pr__st"></span>
    <strong></strong>
    <p></p>
    <small></small>
  </dialog>
</div>
<script>
(function () {
  var root = document.getElementById('blko-pr-{{ section.id }}');
  if (!root) return;
  var grid = root.querySelector('.blko-pr__grid');
  var dlg = root.querySelector('dialog');
  var url = ((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'apps/blocko/reviews?product_id={{ product.id }}';
  var set = function (s, t) { dlg.querySelector(s).textContent = t || ''; };
  root.querySelector('.blko-pr__x').addEventListener('click', function () { dlg.close(); });
  dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
  fetch(url, {headers: {Accept: 'application/json'}}).then(function (r) {
    if (!r.ok) throw r;
    return r.json();
  }).then(function (d) {
    if (!d.connected) return;
    (d.reviews || []).forEach(function (r) {
      (r.photos || []).forEach(function (src) {
        var b = document.createElement('button');
        var img = document.createElement('img');
        b.type = 'button';
        img.src = src;
        img.alt = r.title || r.author;
        img.loading = 'lazy';
        b.appendChild(img);
        b.addEventListener('click', function () {
          dlg.querySelector('img').src = src;
          set('.blko-pr__st', '★★★★★'.slice(0, r.rating));
          set('strong', r.title);
          set('p', r.body);
          set('small', r.author + (r.date ? ' · ' + r.date : ''));
          dlg.showModal();
        });
        grid.appendChild(b);
      });
    });
    root.hidden = !grid.children.length;
  }).catch(function () {});
})();
</script>
{%- endif -%}
<style>
  .blko-pr { max-width: 1200px; margin-inline: auto; padding: 40px 16px; font: inherit; }
  .blko-pr[hidden] { display: none; }
  .blko-pr__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .blko-pr__grid button { padding: 0; border: 1px solid rgba(0,0,0,.12); border-radius: 12px; overflow: hidden; cursor: pointer; background: none; aspect-ratio: 1; }
  .blko-pr__grid img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .blko-pr__dlg { max-width: min(480px, 92vw); border: 0; border-radius: 12px; padding: 16px; }
  .blko-pr__dlg[open] { display: grid; gap: 6px; }
  .blko-pr__dlg img { width: 100%; max-height: 60vh; object-fit: contain; border-radius: 8px; }
  .blko-pr__dlg p { margin: 0; }
  .blko-pr__dlg small { opacity: .7; }
  .blko-pr__st { color: var(--c); }
  .blko-pr__x { justify-self: end; border: 0; background: none; font-size: 24px; line-height: 1; cursor: pointer; }
  @media (min-width: 750px) { .blko-pr__grid { grid-template-columns: repeat(4, 1fr); } }
</style>
{% schema %}
{
  "name": "Blocko Photo Reviews",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Customer photos"},
    {"type": "text", "id": "close", "label": "Close button label", "default": "Close"},
    {"type": "color", "id": "color", "label": "Star color", "default": "#6538bd"}
  ],
  "presets": [{"name": "Blocko Photo Reviews"}],
  "enabled_on": {"templates": ["product"]}
}
{% endschema %}
