<i hidden data-blko-block="quantity-breaks"></i>
<script src="{{ shop.secure_url }}/apps/blocko/beacon.js" defer></script>
{%- liquid
  assign blko_show = true
  if product and section.settings.only_collection != blank
    assign blko_show = false
    for blko_c in product.collections
      if blko_c.id == section.settings.only_collection.id
        assign blko_show = true
        break
      endif
    endfor
  endif
  if product and blko_show and section.settings.only_tag != blank
    assign blko_tag = section.settings.only_tag | strip | downcase
    assign blko_show = false
    for blko_t in product.tags
      assign blko_tt = blko_t | downcase
      if blko_tt == blko_tag
        assign blko_show = true
        break
      endif
    endfor
  endif
-%}
{%- if blko_show -%}
{%- assign st = section.settings -%}
<style>
.blko-qb{max-width:1200px;margin-inline:auto;padding:40px 16px;font:inherit}
.blko-qb>*{max-width:520px}.blko-qb h2{margin:0 0 20px}
.blko-qb .r{position:relative;display:flex;align-items:center;gap:10px;padding:12px 14px;margin-bottom:14px;background:#fff;color:#17151d;border:1px solid rgba(0,0,0,.12);border-radius:12px;cursor:pointer}
.blko-qb .r:has(input:checked){border-color:var(--c)}
.blko-qb input{accent-color:var(--c)}.blko-qb .g{flex:1}.blko-qb small{display:block;opacity:.65}
.blko-qb .t{position:absolute;top:-9px;right:14px;background:var(--c);color:#fff;font-size:10px;padding:2px 9px;border-radius:99px}
.blko-qb button{width:100%;padding:12px;border:0;border-radius:99px;background:#17151d;color:#fff;font:inherit;cursor:pointer}
</style>
<div class="blko-qb" id="blko-qb-{{ section.id }}" style="--c:{{ st.color }}"><h2></h2><div></div><button type="button">{{ st.button }}</button></div>
<script>(()=>{
const s=document.getElementById('blko-qb-{{ section.id }}'),R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',J={'Content-Type':'application/json'},
M={{ shop.money_format | json }},V0={{ product.selected_or_first_available_variant.id }},P0={{ product.selected_or_first_available_variant.price }},
P={ {%- for v in product.variants -%}{{ v.id }}:{{ v.price }},{%- endfor -%} },
b=s.querySelector('button'),L=s.querySelector('div'),T=b.textContent,
m=c=>M.replace(/\{\{\s*\w+\s*\}\}/,(c/100).toFixed(2)),
F=()=>document.querySelector('form[action*="/cart/add"] [name=id]'),
e=(g,x,p)=>{const n=document.createElement(g);n.textContent=x||'';p.appendChild(n);return n};
let o,D,k=1;
if({{ st.use_aov | json }})try{o={{ shop.metafields.avada_bundle.offer | json }};if(typeof o==='string')o=JSON.parse(o);
o=(o||[]).find(x=>x.type==='volume-discount'&&x.status==='active'&&(x.triggerProducts||[]).some(p=>String(p.id)==='{{ product.id }}'))}catch(x){}
D=o&&o.discountInformation;
if(D&&D.length)k=Math.max(0,D.findIndex(t=>t.isDefault));
else{o=0;D=[{%- for n in (1..3) -%}{%- assign a = 'off' | append: n -%}{%- assign g = 'tag' | append: n -%}{%- assign d = st[a] | default: 0 -%}{quantity:{{ n }},discountType:'percentage',discountValue:{{ d }},isDefault:true,badgeText:{{ st[g] | json }},title:{{ st.buy | append: ' ' | append: n | json }},subTitle:{{ st.save | append: ' ' | append: d | append: '%' | json }}},{%- endfor -%}]}
s.querySelector('h2').textContent=o?o.volumeTitle:{{ st.heading | json }};
const p=P[(F()||{}).value]||P0;
D.forEach((t,i)=>{const q=t.quantity,pc=t.discountType==='percentage',d=pc?t.discountValue:0,full=p*q,
v=pc?t.discountValue+'%':m(t.discountValue*100),l=e('label',0,L),r=e('input',0,l),g=e('span',0,l);
l.className='r';r.type='radio';r.name='q{{ section.id }}';r.checked=i==k;r.onchange=()=>k=i;g.className='g';
e('strong',t.title.replace(/\{\{\s*product_quantity\s*\}\}/,q),g);
if(d>0||o)e('small',t.subTitle.replace(/\{\{\s*discount_value\s*\}\}/,v),g);
if(d>0)e('s',m(full),l);e('strong',m(full*(100-d)/100|0),l);
if(t.isDefault&&t.badgeText)e('span',t.badgeText,l).className='t'});
b.onclick=async()=>{b.disabled=true;try{const f=F(),t=D[k],it={id:f&&f.value||V0,quantity:t.quantity};
if(o)it.properties={_aov_bundles:JSON.stringify({offerId:o.id})};
const a=await fetch(R+'cart/add.js',{method:'POST',headers:J,body:JSON.stringify(it)});if(!a.ok)throw await a.json();
if(o&&t.discountValue>0&&o.code){const c=(await(await fetch(R+'cart.js')).json()).discount_codes.map(d=>d.code);if(!c.includes(o.code))c.push(o.code);
await fetch(R+'cart/update.js',{method:'POST',headers:J,body:JSON.stringify({discount:c.join(',')})})}
b.disabled=false;(self.BlkoAdded||(()=>location=R+'cart'))()}catch(x){b.disabled=false;b.textContent=x.description||T}}})();</script>
{%- endif -%}
{% schema %}
{"name":"Blocko Quantity Breaks","enabled_on":{"templates":["product"]},"presets":[{"name":"Blocko Quantity Breaks"}],"settings":[{"type":"checkbox","id":"use_aov","label":"Use the AOV.ai offer when this product has one","default":true},{"type":"text","id":"heading","label":"Heading","default":"Buy more, save more"},{"type":"text","id":"buy","label":"Row label","default":"Buy"},{"type":"text","id":"save","label":"Saving label","default":"Save"},{"type":"range","id":"off1","label":"Buy 1 saving %","min":0,"max":50,"default":0},{"type":"range","id":"off2","label":"Buy 2 saving %","min":0,"max":50,"default":15},{"type":"range","id":"off3","label":"Buy 3 saving %","min":0,"max":50,"default":25},{"type":"text","id":"tag1","label":"Buy 1 tag"},{"type":"text","id":"tag2","label":"Buy 2 tag","default":"Most popular"},{"type":"text","id":"tag3","label":"Buy 3 tag","default":"Best value"},{"type":"text","id":"button","label":"Button text","default":"Add to cart"},{"type":"color","id":"color","label":"Accent color","default":"#6538bd"},{"type":"paragraph","content":"AOV mode: if this product has an active AOV.ai volume offer, tiers, text and code come from it. Settings mode: otherwise the tiers above are display only, so create a matching Shopify automatic discount for checkout."},{"type":"header","content":"Show on"},{"type":"collection","id":"only_collection","label":"Only products in this collection","info":"Leave both empty to show on every product."},{"type":"text","id":"only_tag","label":"Only products with this tag"}]}
{% endschema %}
