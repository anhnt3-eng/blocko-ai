<i hidden data-blko-block="review-form"></i>
<script src="{{ shop.secure_url }}/apps/blocko/beacon.js" defer></script>
{%- comment -%}Blocko review form. Sends the review to the Blocko app via the App Proxy (/apps/blocko/review).{%- endcomment -%}
{%- liquid
  assign blko_show = true
  if product and section.settings.only_collection != blank
    assign blko_show = false
    for blko_c in product.collections
      if blko_c.id == section.settings.only_collection.id
        assign blko_show = true
        break
      endif
    endfor
  endif
  if product and blko_show and section.settings.only_tag != blank
    assign blko_tag = section.settings.only_tag | strip | downcase
    assign blko_show = false
    for blko_t in product.tags
      assign blko_tt = blko_t | downcase
      if blko_tt == blko_tag
        assign blko_show = true
        break
      endif
    endfor
  endif
-%}
{%- if blko_show -%}
{%- if product -%}
<div class="blko-rf page-width" id="blko-rf-{{ section.id }}">
  <h2>{{ section.settings.heading | escape }}</h2>
  <form novalidate>
    <fieldset class="blko-rf__stars">
      <legend>Rating</legend>
      {%- for i in (1..5) reversed -%}
        <input type="radio" id="blko-rf-{{ section.id }}-{{ i }}" name="rating" value="{{ i }}" required>
        <label for="blko-rf-{{ section.id }}-{{ i }}" title="{{ i }} stars">★</label>
      {%- endfor -%}
    </fieldset>
    <input name="name" placeholder="Your name" required maxlength="80" value="{{ customer.first_name | escape }}">
    <input name="email" type="email" placeholder="Email" required maxlength="200" value="{{ customer.email | escape }}">
    <input name="title" placeholder="Title (optional)" maxlength="150">
    <textarea name="body" placeholder="Your review" required maxlength="5000" rows="4"></textarea>
    <button type="submit" class="button">Submit review</button>
    <p class="blko-rf__msg" role="status"></p>
  </form>
</div>
<script>
(function () {
  var root = document.getElementById('blko-rf-{{ section.id }}');
  if (!root) return;
  var form = root.querySelector('form');
  var msg = root.querySelector('.blko-rf__msg');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!form.reportValidity()) return;
    var d = new FormData(form);
    var btn = form.querySelector('button');
    btn.disabled = true;
    msg.textContent = 'Sending...';
    fetch(((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'apps/blocko/review', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        rating: Number(d.get('rating')), name: d.get('name'), email: d.get('email'),
        title: d.get('title'), body: d.get('body'),
        productId: '{{ product.id }}', productHandle: {{ product.handle | json }},
        productTitle: {{ product.title | json }},
        block: 'review-form', section: '{{ section.id }}'
      })
    }).then(function (r) {
      if (!r.ok) throw r;
      form.reset();
      msg.textContent = 'Thanks! Your review was sent.';
    }).catch(function () {
      msg.textContent = 'Could not send your review. Please try again.';
    }).finally(function () { btn.disabled = false; });
  });
})();
</script>
{%- endif -%}
<style>
  .blko-rf { padding: 40px 16px; max-width: 640px; margin-inline: auto; }
  .blko-rf form { display: grid; gap: 12px; }
  .blko-rf input:not([type=radio]), .blko-rf textarea { width: 100%; padding: 10px 12px; font: inherit; border: 1px solid rgba(0,0,0,.2); border-radius: 6px; }
  .blko-rf__stars { border: 0; padding: 0; margin: 0; display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 4px; }
  .blko-rf__stars legend { width: 100%; margin-bottom: 4px; }
  .blko-rf__stars input { position: absolute; opacity: 0; }
  .blko-rf__stars label { font-size: 28px; color: #ccc; cursor: pointer; }
  .blko-rf__stars input:checked ~ label, .blko-rf__stars label:hover, .blko-rf__stars label:hover ~ label { color: #f5a623; }
  .blko-rf__msg { min-height: 1.2em; margin: 0; }
</style>
{%- endif -%}
{% schema %}
{"name":"Blocko review form","settings":[{"type":"text","id":"heading","label":"Heading","default":"Write a review"},{"type":"header","content":"Show on"},{"type":"collection","id":"only_collection","label":"Only products in this collection","info":"Leave both empty to show on every product."},{"type":"text","id":"only_tag","label":"Only products with this tag"}],"presets":[{"name":"Blocko review form"}],"enabled_on":{"templates":["product"]}}
{% endschema %}
